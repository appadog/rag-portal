# Local free-model services. Run the matching profile in docker-compose.models.yml.
RAG_EMBEDDING_URL_BGE_M3=http://127.0.0.1:8081
RAG_EMBEDDING_URL_QWEN3_EMBEDDING_0_6B=http://127.0.0.1:8082
RAG_EMBEDDING_URL_EMBEDDINGGEMMA_300M=http://127.0.0.1:8083
RAG_RERANKER_URL=http://127.0.0.1:8084

# Grounded answer generator. It must expose POST /generate and return
# sentence-level citation_ids that refer only to the submitted contexts.
RAG_GENERATOR_URL=http://127.0.0.1:8085
RAG_GENERATOR_MODEL=local-grounded-generator

# Immutable original-source storage for reproducible parse/reparse runs.
# Default local adapter: relative to apps/backend when Uvicorn is started there.
RAG_SOURCE_STORAGE_BACKEND=local
RAG_SOURCE_STORAGE_PATH=.rag-sources
# Object-storage gateway adapter (path-style PUT/GET {endpoint}/{bucket}/{key}).
# RAG_SOURCE_STORAGE_BACKEND=object
# RAG_OBJECT_STORAGE_ENDPOINT=https://object-gateway.internal
# RAG_OBJECT_STORAGE_BUCKET=rag-portal-sources
# RAG_OBJECT_STORAGE_TOKEN=

# Multi-document grounded search: each finalized document keeps its own
# retrieval configuration, then selected evidence is globally merged.
RAG_MULTI_DOCUMENT_CONTEXT_LIMIT=4
RAG_MULTI_DOCUMENT_RERANK_TOP_K=8

# Optional Hugging Face Inference Providers fallback. Leave empty for a fully local deployment.
HF_TOKEN=
HF_EMBEDDING_PROVIDER=hf-inference

# Job dispatch: thread is the no-dependency development fallback. Redis and
# SQS-compatible queues publish only {job_id, idempotency_key}; a worker uses
# app.main.consume_dispatched_job(job_id, idempotency_key) to execute it.
RAG_QUEUE_BACKEND=thread
REDIS_URL=redis://127.0.0.1:6379/0
RAG_SQS_QUEUE_URL=
RAG_SQS_ENDPOINT_URL=
RAG_SQS_MESSAGE_GROUP_ID=rag-portal
RAG_JOB_MAX_ATTEMPTS=3
RAG_JOB_RETRY_BACKOFF_SECONDS=0
# Leave empty to expose the adapter-derived worker name in observability.
RAG_WORKER_ID=

# The OCR parser requires the system Tesseract binary and Korean/English language packs.
