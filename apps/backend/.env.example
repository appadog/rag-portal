# Local free-model services. Run the matching profile in docker-compose.models.yml.
RAG_EMBEDDING_URL_BGE_M3=http://127.0.0.1:8081
RAG_EMBEDDING_URL_QWEN3_EMBEDDING_0_6B=http://127.0.0.1:8082
RAG_EMBEDDING_URL_EMBEDDINGGEMMA_300M=http://127.0.0.1:8083
RAG_RERANKER_URL=http://127.0.0.1:8084

# Optional Hugging Face Inference Providers fallback. Leave empty for a fully local deployment.
HF_TOKEN=
HF_EMBEDDING_PROVIDER=hf-inference

# Set to redis after starting docker compose; otherwise the durable local thread backend is used.
RAG_QUEUE_BACKEND=thread
REDIS_URL=redis://127.0.0.1:6379/0

# The OCR parser requires the system Tesseract binary and Korean/English language packs.
